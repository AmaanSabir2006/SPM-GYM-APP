# ==============================================================================
# GymTrack Backend - Environment Variables Template
# Copy this file to `backend/.env` and update the values with your credentials.
# ==============================================================================

PROJECT_NAME="GymTrack SaaS Backend"
ENVIRONMENT="development"

# Security: Generate a strong key with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY="change-this-to-a-very-secure-random-secret-key-for-jwt"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ------------------------------------------------------------------------------
# Supabase PostgreSQL Connection
# ------------------------------------------------------------------------------
# In Supabase: Project Settings -> Database -> Connection string -> URI
# Replace with 'postgresql+asyncpg://...' for async SQLAlchemy:
# Example: postgresql+asyncpg://postgres.your-ref:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
DATABASE_URL="postgresql+asyncpg://postgres:YOUR_PASSWORD@db.YOUR_SUPABASE_PROJECT_REF.supabase.co:5432/postgres"

# CORS Allowed Origins (Comma-separated list in JSON format)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]
